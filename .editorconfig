root = true

# 统一基础风格：UTF-8、LF、文件末尾留一个空行、不留行尾空格
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.ps1]
end_of_line = crlf
indent_size = 4

[*.bat]
end_of_line = crlf

[*.{yml,yaml,json,csv}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
