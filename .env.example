# CBC Insight 环境变量示例（复制成 backend/.env 后按需修改）
#
# v1.8 起程序**会**读取 backend/.env（pydantic-settings 的 env_file 指向绝对路径，
# 所以从仓库根、从 backend/、从 IDE 启动都能读到同一份）。优先级：进程环境变量 >
# backend/.env > 代码默认值。CI 与测试一律用环境变量覆盖，不依赖这个文件。
#
# backend/.env 已在 .gitignore 里：里面有连接串与密钥，不能进仓库。
#
# 变量前缀固定为 CBC_，字段名大写（CBC_MAX_ROWS 对应 settings.max_rows）。

# ── 存储 ────────────────────────────────────────────────────────────────
# 默认 SQLite（零依赖，适合课程演示）；本项目开发机已切到 WSL 里的 Postgres：
#   wsl -u postgres -- psql -c "CREATE ROLE cbc LOGIN PASSWORD '...';"
#   wsl -u postgres -- psql -c "CREATE DATABASE cbc OWNER cbc ENCODING 'UTF8' TEMPLATE template0;"
# 结构用 alembic 管理：cd backend && .venv\Scripts\python.exe -m alembic upgrade head
# 旧数据搬迁：.venv\Scripts\python.exe ..\scripts\migrate_to_pg.py --target <url>
CBC_DATABASE_URL=postgresql+psycopg://cbc:cbc_dev_password@127.0.0.1:5432/cbc
# 退回 SQLite（与 PG 数据互不影响）：
# CBC_DATABASE_URL=sqlite:///D:/Project/Study Auto/cbc-insight/backend/data/app.db

# 原始 CSV、parquet、报告、图片都落在这里；容器里指向卷
CBC_DATA_DIR=D:/Project/Study Auto/cbc-insight/backend/data

# Redis 只用于**缓存**（统计与图表载荷）。留空则退化为进程内 TTL 缓存，
# 单机开发不需要装 Redis；多进程部署时必须配置，否则各进程各缓存各的。
# CBC_REDIS_URL=redis://127.0.0.1:6379/0

# ── 限额（NFR-P / NFR-S）────────────────────────────────────────────────
CBC_MAX_UPLOAD_BYTES=52428800
CBC_MAX_ROWS=200000
CBC_MAX_COLUMNS=60
CBC_MAX_DATASETS_PER_USER=20
CBC_POINTS_LIMIT=2000
CBC_SYNC_CLEAN_BUDGET_SECONDS=30

# ── 鉴权 ────────────────────────────────────────────────────────────────
# 生产必须换掉；PyJWT 会警告短密钥，但"警告没人看"正是生产事故的常见起点
CBC_JWT_SECRET=change-me-in-production-0123456789abcdef
CBC_ACCESS_TOKEN_MINUTES=30
CBC_REFRESH_TOKEN_DAYS=7
CBC_BCRYPT_COST=12
CBC_LOGIN_MAX_FAILURES=5
CBC_LOGIN_LOCK_MINUTES=15

# ── 网络 ────────────────────────────────────────────────────────────────
# 默认只监听本机（NFR-S-08）；容器里必须 0.0.0.0 才能被 nginx 访问
CBC_HOST=127.0.0.1
CBC_PORT=8000
CBC_ALLOWED_ORIGINS=["http://localhost:5173"]
